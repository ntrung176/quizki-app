  "usages": [
    {
      "explain": "This grammar pattern uses the structure 「それなら / それじゃ / じゃ...わけだ」to present the listener's conclusion after receiving information from the speaker.",
      "note": null,
      "examples": [
        {
          "content": "山田さんは４年アメリカに留学していたそうですよ。それなら、英語は上手なわけですね。",
          "transcription": "やまださんはよんねんあめりかにりゅうがくしていたそうですよ。それなら、えいごはじょうずなわけですね。",
          "mean": "Mr. Yamada apparently studied abroad in America for four years. Then your English is good."
        },
        {
          "content": "彼は来月から退職するそうですよ。それじゃ、彼はこれから<br>仕事の責任から開放されるわけですね。",
          "transcription": "かれはらいげつからたいしょくするそうですよ。それじゃ、かれはこれから<br>しごとのせきにんからかいほうされるわけですね。",
          "mean": "It seems that he will retire from next month. Well then, he will be freed from his work responsibilities from now on."
        }
      ],
      "mean": null,
