{"default":{"patterns":{"ageru":{"jp":"〜上げる","vi":"làm xong, hoàn thành trọn vẹn","note":"Gắn sau thân động từ thể ます biểu thị một hành động hay công việc đã được hoàn thành một cách trọn vẹn, xuất sắc."},"arayuru":{"jp":"あらゆる","vi":"tất cả, toàn bộ, mọi","note":"Định từ đứng trước danh từ để chỉ tất cả mọi đối tượng trong phạm vi mà không loại trừ cái nào."},"aruiwa":{"jp":"あるいは","vi":"hoặc là, nói cách khác","note":"Liên từ dùng để đưa ra một lựa chọn khác hoặc diễn đạt lại nội dung vừa nói theo cách khác."},"au":{"jp":"〜合う","vi":"cùng nhau, lẫn nhau","note":"Ghép sau thân động từ thể ます để biểu thị hai hay nhiều đối tượng cùng làm gì cho nhau."},"daga":{"jp":"だが／しかし","vi":"nhưng mà, tuy nhiên","note":"Liên từ dùng để biểu thị sự đối lập, tương phản giữa nội dung ở hai vế câu."},"dekireba":{"jp":"できれば","vi":"nếu có thể, nếu được","note":"Dùng khi đưa ra yêu cầu hoặc nhờ vả một cách lịch sự, tế nhị rằng nếu có thể thì mong đối phương làm giúp."},"douka":{"jp":"どうか","vi":"xin vui lòng, thế nào","note":"Dùng khi tha thiết nhờ vả, cầu xin hoặc bày tỏ sự nghi ngại, băn khoăn về sự việc."},"douse":{"jp":"どうせ","vi":"đằng nào thì, kiểu gì cũng","note":"Dùng khi nhận định kết quả cuối cùng dù thế nào cũng không thay đổi, thường mang ý buông xuôi."},"doushi":{"jp":"動詞","vi":"động từ chỉ hành động","note":"Từ dùng để diễn đạt hành động, sự vận động hoặc trạng thái của chủ thể."},"doushi-keiyoushi":{"jp":"動詞／形容詞","vi":"động từ hoặc tính từ","note":"Từ loại gồm động từ hoặc tính từ dùng để diễn tả cảm xúc, trạng thái yêu ghét."},"doushi-meishi":{"jp":"動詞／名詞","vi":"động từ hoặc danh từ","note":"Từ có thể vừa đóng vai trò danh từ vừa có thể kết hợp với suru để làm động từ."},"fukugoudoushi":{"jp":"複合動詞","vi":"động từ ghép kết hợp","note":"Động từ ghép được tạo thành bằng cách ghép hai động từ lại để biểu đạt ý nghĩa mới."},"fukugougo":{"jp":"複合語","vi":"từ ghép, từ phức","note":"Từ được cấu tạo bằng cách ghép hai hoặc nhiều từ đơn lại để tạo thành nghĩa mới."},"fukushi":{"jp":"副詞","vi":"phó từ, trạng từ","note":"Dùng để bổ nghĩa cho động từ, tính từ hoặc cả câu nhằm làm rõ mức độ, tình trạng hay cách thức của sự việc."},"fukushi-keiyoushi":{"jp":"副詞／形容詞","vi":"phó từ hoặc tính từ","note":"Nhóm từ có thể dùng linh hoạt như phó từ bổ nghĩa hoặc tính từ chỉ trạng thái."},"gisshiri":{"jp":"ぎっしり","vi":"chật kín, kín mít, đầy ắp","note":"Phó từ miêu tả không gian bị lấp đầy, người hoặc đồ vật xếp chật ních không còn khoảng trống."},"gitaigo":{"jp":"擬態語","vi":"từ tượng hình, mô tả trạng thái","note":"Từ dùng để mô tả hình ảnh, cử chỉ, dáng vẻ hoặc trạng thái của người và sự vật."},"goi":{"jp":"語彙","vi":"từ vựng, vốn từ tiếng Nhật","note":"Các đơn vị từ vựng độc lập được dùng để biểu thị khái niệm, sự vật hoặc trạng thái."},"goku":{"jp":"語句","vi":"từ ngữ, cụm từ biểu đạt","note":"Tập hợp từ hoặc cụm từ biểu đạt một ý nghĩa cố định trong câu tiếng Nhật."},"gyaku-ni":{"jp":"逆に","vi":"ngược lại, trái lại","note":"Dùng để chỉ sự việc, hành động diễn biến theo chiều hướng trái ngược với bình thường hoặc dự tính."},"hitomazu":{"jp":"ひとまず","vi":"tạm thời, trước mắt thì","note":"Phó từ diễn tả việc tạm thời làm một việc gì đó trước mắt trong hoàn cảnh hiện tại."},"honno":{"jp":"ほんの","vi":"chỉ là một chút, thoáng chốc","note":"Đứng trước từ chỉ số lượng hoặc thời gian ngắn để nhấn mạnh mức độ ít ỏi, nhỏ bé hoặc thoáng qua."},"i-na":{"jp":"〜い／〜な","vi":"tính từ đuôi i và đuôi na","note":"Dùng để miêu tả đặc điểm, tính chất, trạng thái của sự vật, hiện tượng hoặc cảm xúc của con người."},"ichiji":{"jp":"一時","vi":"nhất thời, có lúc, tạm thời","note":"Dùng để chỉ một khoảng thời gian ngắn, mang tính tạm thời hoặc một thời điểm từng xảy ra trong quá khứ."},"imasara":{"jp":"今さら","vi":"đến giờ này thì đã muộn","note":"Dùng khi nhấn mạnh rằng sự việc đã quá trễ, bây giờ có làm gì hay nói gì đi nữa thì cũng vô ích."},"iwayuru":{"jp":"いわゆる","vi":"cái gọi là, nôm na là","note":"Đứng trước danh từ để chỉ cách gọi thông thường, quen thuộc của mọi người về một sự vật hay hiện tượng."},"kakeru":{"jp":"〜かける／かけだ","vi":"làm dở, chưa xong","note":"Dùng để diễn tả một hành động đang thực hiện dở dang, chưa hoàn thành trọn vẹn."},"kanarazushimo-nai":{"jp":"必ずしも〜ない","vi":"chưa hẳn, không nhất thiết","note":"Đi với dạng phủ định để phủ định một phần, mang ý không phải mọi trường hợp đều đúng."},"kanenai":{"jp":"〜かねない","vi":"có khả năng xảy ra kết quả xấu","note":"Dùng khi cảnh báo một nguyên nhân hiện tại có thể dẫn đến một kết quả xấu, tiêu cực ngoài ý muốn."},"kaneru":{"jp":"〜かねる","vi":"khó lòng mà làm được","note":"Dùng trong văn phong lịch sự, trang trọng để từ chối một cách khéo léo việc mình không thể thực hiện."},"keiyoushi-meishi":{"jp":"形容詞／名詞","vi":"tính từ hoặc danh từ","note":"Nhóm từ vựng có thể đóng vai trò là tính từ chỉ tính chất hoặc danh từ biểu thị sự việc."},"komu":{"jp":"〜込む","vi":"vào trong, kỹ càng, chìm vào","note":"Gắn sau thân động từ thể ます biểu thị hành động đi sâu vào bên trong hoặc chuyển biến sâu vào một trạng thái."},"mada-te-inai":{"jp":"まだ〜ていない","vi":"vẫn chưa thực hiện","note":"Dùng để diễn tả một hành động hoặc trạng thái kỳ vọng tới nay vẫn chưa diễn ra hay hoàn thành."},"manichi-mangaichi":{"jp":"万一／万が一","vi":"nếu lỡ, vạn nhất","note":"Dùng để giả định một tình huống xấu hoặc bất trắc có thể xảy ra ngoài ý muốn."},"meishi":{"jp":"名詞","vi":"danh từ, từ chỉ sự vật","note":"Dùng để chỉ số lượng nhỏ, một phần ít ỏi hoặc mức độ vừa phải của sự vật."},"motomoto":{"jp":"もともと","vi":"vốn dĩ là, ban đầu là","note":"Dùng để chỉ bản chất vốn có, tình trạng tự nhiên từ ban đầu của sự vật, sự việc."},"mushiro":{"jp":"むしろ","vi":"thà rằng, đúng ra thì","note":"Dùng khi so sánh hai sự việc để nhấn mạnh rằng vế sau mới thực sự đúng hoặc thích hợp hơn."},"na":{"jp":"〜な","vi":"tính từ đuôi na","note":"Dùng tính từ đuôi な để bổ nghĩa cho danh từ đi sau hoặc làm vị ngữ miêu tả đặc điểm, tính chất."},"nai":{"jp":"〜ない","vi":"không ... (thể phủ định)","note":"Dùng để diễn tả dạng phủ định của hành động hoặc trạng thái, biểu thị việc không thực hiện hoặc không xảy ra."},"nantomo-nai":{"jp":"なんとも〜ない","vi":"chẳng sao cả, không hề hấn gì","note":"Dùng để diễn tả không bị thương tật, không hề hấn gì, hoặc không thể cảm nhận rõ ràng điều gì."},"naosu":{"jp":"〜直す","vi":"làm lại, thực hiện lại","note":"Ghép sau thân động từ thể ます để biểu thị việc thực hiện lại hành động một lần nữa."},"naze-ka":{"jp":"なぜか","vi":"không hiểu sao, chẳng hiểu vì sao","note":"Phó từ dùng khi người nói không rõ lý do hay nguyên nhân cụ thể dẫn đến sự việc hoặc cảm xúc đó."},"ni-atehamaru":{"jp":"〜に当てはまる","vi":"phù hợp, áp dụng đúng với","note":"Đi với danh từ để biểu thị một quy tắc, tiêu chuẩn hay điều kiện áp dụng đúng với đối tượng."},"ni-sessuru":{"jp":"〜に接する","vi":"tiếp xúc, tiếp giáp, đối xử","note":"Diễn tả sự tiếp xúc, đối xử với con người hoặc vị trí tiếp giáp, liền kề với khu vực địa lý."},"ni-shitagatte":{"jp":"〜にしたがって","vi":"cùng với, theo như, tuân theo","note":"Dùng để diễn tả sự thay đổi tỉ lệ thuận hoặc hành động tuân theo chỉ thị, quy định."},"ni-sotte":{"jp":"〜に沿って／〜に沿い","vi":"men theo, bám sát, tuân theo","note":"Diễn tả hành động làm theo, bám sát phương châm, quy tắc, kế hoạch hoặc men theo một tuyến đường dài."},"ni-tsuku":{"jp":"〜に就く","vi":"đảm nhiệm, bắt đầu, nhận chức","note":"Đi sau danh từ để biểu thị việc đảm nhận chức vụ, bắt tay vào công việc hoặc đi vào trạng thái."},"ochitsuku":{"jp":"落ち着く","vi":"bình tĩnh lại, trở nên yên tĩnh","note":"Diễn tả trạng thái tâm lý ổn định, bình tâm trở lại hoặc không gian trở nên yên ắng, lắng đọng."},"rengo":{"jp":"連語","vi":"cụm từ cố định, kết hợp từ","note":"Cách kết hợp các từ ngữ đi liền với nhau theo thói quen tự nhiên để tạo thành cụm từ hoàn chỉnh."},"reru-rareru":{"jp":"〜れる／〜られる","vi":"tự nhiên, bất giác, bỗng thấy","note":"Đi với các động từ tâm lý, tri giác như 思う, 思い出す để diễn tả cảm xúc tự nhiên trào dâng."},"sashiatatte":{"jp":"さしあたって","vi":"trước mắt thì, tạm thời thì","note":"Dùng để chỉ hành động hoặc trạng thái giải quyết tình hình tạm thời trong hiện tại trước mắt."},"seizei":{"jp":"せいぜい","vi":"cùng lắm là, tối đa là","note":"Chỉ mức độ tối đa hoặc giới hạn cao nhất có thể đạt được, thường mang sắc thái đánh giá là ít ỏi."},"semete":{"jp":"せめて","vi":"ít nhất thì, ít ra thì","note":"Diễn tả mong muốn hoặc yêu cầu đạt được mức tối thiểu có thể chấp nhận được trong một hoàn cảnh."},"setsuzokushi":{"jp":"接続詞","vi":"liên từ, từ nối","note":"Dùng để liên kết các câu hoặc vế câu nhằm bổ sung thông tin hoặc tăng tiến mức độ."},"shitagatte":{"jp":"したがって","vi":"theo đó, do đó, vì vậy","note":"Liên từ trang trọng dùng để nêu ra kết quả tất yếu xuất phát từ lý do ở vế trước."},"sono-ue":{"jp":"その上","vi":"hơn nữa, thêm vào đó","note":"Liên từ dùng để bổ sung thêm thông tin hoặc mức độ cùng chiều với vế câu phía trước."},"souieba":{"jp":"そういえば","vi":"nhắc mới nhớ, nghĩ kỹ thì","note":"Liên từ dùng khi sực nhớ ra điều gì đó liên quan tới câu chuyện vừa được nghe hoặc nhắc đến."},"tadoushi":{"jp":"他動詞","vi":"tha động từ tác động","note":"Động từ diễn tả hành động có chủ ý tác động trực tiếp lên tân ngữ đi với trợ từ を."},"taishite-nai":{"jp":"たいして〜ない","vi":"không... lắm, không mấy","note":"Phó từ đi với thể phủ định để biểu thị mức độ không nhiều, không đáng kể hoặc không có gì to tát."},"tanni":{"jp":"単に","vi":"chỉ, đơn thuần là","note":"Phó từ dùng để nhấn mạnh tính chất đơn thuần, chỉ ở mức độ đó chứ không có gì phức tạp."},"to-wa-kagiranai":{"jp":"〜とは限らない","vi":"không hẳn là, chưa chắc đã","note":"Dùng để phủ định một phần nhận định chung, mang nghĩa không phải lúc nào 100% sự việc cũng như vậy."},"tonikaku":{"jp":"とにかく","vi":"dù sao thì, nói gì thì nói","note":"Dùng để gác lại mọi chuyện khác sang một bên nhằm nhấn mạnh điều quan trọng nhất trước mắt."},"toujitsu":{"jp":"当日","vi":"ngày hôm đó, ngày diễn ra","note":"Danh từ dùng để chỉ chính ngày diễn ra sự kiện, hoạt động hoặc sự việc đang được đề cập tới."},"toutei-nai":{"jp":"とうてい〜ない","vi":"hoàn toàn không thể, không tài nào","note":"Đi với động từ phủ định để nhấn mạnh rằng dù có cố gắng đến đâu cũng hoàn toàn không thể làm được."},"tsugitsugi-to":{"jp":"次々と","vi":"liên tục, cái này sau cái kia","note":"Phó từ diễn tả các hành động hoặc sự việc diễn ra nối tiếp nhau liên tục không ngừng nghỉ."},"tsuide-ni":{"jp":"〜ついでに","vi":"nhân tiện, tiện thể","note":"Diễn tả việc nhân cơ hội thực hiện hành động chính mà làm thêm một việc khác tiện đường."},"tsumari":{"jp":"つまり","vi":"tức là, có nghĩa là","note":"Dùng để giải thích, làm rõ nghĩa hoặc tóm lược lại ý cốt lõi của nội dung vừa được nêu ở vế trước."},"wazato":{"jp":"わざと","vi":"cố ý, cố tình","note":"Dùng khi ai đó chủ ý làm một hành động, thường dẫn đến tình huống không tốt hoặc gây phiền phức cho người khác."},"zaru-o-enai":{"jp":"〜ざるを得ない","vi":"đành phải, buộc phải","note":"Diễn tả tình thế dù bản thân không muốn nhưng vì hoàn cảnh bắt buộc nên đành phải làm như vậy."},"zurari-to":{"jp":"ずらりと／ずらっと","vi":"thành hàng dài, la liệt","note":"Phó từ miêu tả nhiều đồ vật hoặc con người được xếp thẳng thành một hàng dài liên tiếp."}},"byQuestion":{"test-12-q28":"meishi","test-14-q28":"meishi","test-16-q16":"meishi","test-17-q27":"meishi","test-18-q17":"doushi","test-19-q27":"doushi","test-19-q40":"doushi","test-21-q23":"meishi","test-22-q16":"na","test-24-q13":"meishi","test-25-q38":"doushi","test-26-q40":"kaneru","test-27-q40":"ni-sessuru","test-29-q25":"kanarazushimo-nai","test-30-q1":"meishi","test-30-q10":"meishi","test-30-q11":"meishi","test-30-q12":"meishi","test-30-q13":"meishi","test-30-q14":"meishi","test-30-q15":"meishi","test-30-q16":"meishi","test-30-q17":"meishi","test-30-q18":"meishi","test-30-q19":"meishi","test-30-q2":"meishi","test-30-q20":"meishi","test-30-q21":"meishi","test-30-q22":"meishi","test-30-q23":"fukugougo","test-30-q24":"meishi","test-30-q25":"fukugoudoushi","test-30-q26":"fukugougo","test-30-q27":"meishi","test-30-q28":"fukugoudoushi","test-30-q29":"fukugoudoushi","test-30-q3":"meishi","test-30-q30":"fukugougo","test-30-q31":"fukugoudoushi","te