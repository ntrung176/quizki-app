il uil-notes\"></i> Memo</button>\n\t\t\t\t<!-- <button class=\"btn btn-primary btn-sm rounded-pill btn_tuvungtong\"><i class=\"uil uil-notes\"></i> Từ vựng tổng</button> -->\n\t\t\t</div>\n\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t<div class=\"col-12 nguphap\">\n\t\t\t\t\t<div class=\"jlpt-lesson-cauhoi\">\n\t\t\t\t\t\t<p>►　気分が落ち込み、物事への興味を失うという症状が続き、それが悪化すると、「うつ病」という診断を下される。</p>\n\t\t\t\t\t\t<p class=\"bg-cauvn\">　　Triệu chứng suy sụp tinh thần và mất hứng thú với mọi việc tiếp diễn và nếu tình trạng này trở nên tồi tệ hơn, bệnh nhân sẽ được chẩn đoán là \"trầm cảm\".</p>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"jlpt-lesson-tuvung\">\n\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"accordion accordion-wrapper\" id=\"accordion_13733738_1\">"}]},{"title":"Bài 6","dethiCode":"iGSSxb_HvM2ZpZzNub200KCelMqswoHAZWk-","totalQuestions":1,"questions":[{"cau":"1","question":"","passage":null,"audio":null,"image":null,"choices":[],"correctAnswer":"","explanationText":"Nhiều người nghĩ rằng những nhân vật nổi tiếng hoặc giám đốc của các tập đoàn lớn trên thế giới hẳn phải có trí thông minh cao, nhưng không phải lúc nào cũng vậy.\n\nTóm tắt Dịch Hint Memo Từ vựng tổng --> ► 世界で活躍する著名人や大企業の社長などは、さぞかし知能が高いのだろうと思うが、必ずしもそうだとは言えない。 Nhiều người nghĩ rằng những nhân vật nổi tiếng hoặc giám đốc của các tập đoàn lớn trên thế giới hẳn phải có trí thông minh cao, nhưng không phải lúc nào cũng vậy.","explanationHtml":"<div class=\"jlpt-lesson col-md-8 mx-auto\">\n\t<div class=\"row\">\n\t\t\t\t\t<div class=\"jlpt-lesson-btn-group mb-6\">\n\t\t\t\t<button class=\"btn btn-primary btn-sm rounded-pill btn_tomtat\"><i class=\"uil uil-book-open\"></i> Tóm tắt</button>\n\t\t\t\t<button class=\"btn btn-primary btn-sm rounded-pill btn_dichtong\"><i class=\"uil uil-graduation-cap\"></i> Dịch</button>\n\t\t\t\t<button class=\"btn btn-primary btn-sm rounded-pill btn_hint\"><i class=\"uil uil-lightbulb-alt\"></i> Hint</button>\n\t\t\t\t<button class=\"btn btn-primary btn-sm rounded-pill btn_memo\"><i class=\"uil uil-notes\"></i> Memo</button>\n\t\t\t\t<!-- <button class=\"btn btn-primary btn-sm rounded-pill btn_tuvungtong\"><i class=\"uil uil-notes\"></i> Từ vựng tổng</button> -->\n\t\t\t</div>\n\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t<div class=\"col-12 nguphap\">\n\t\t\t\t\t<div class=\"jlpt-lesson-cauhoi\">\n\t\t\t\t\t\t<p>►　世界で活躍する著名人や大企業の社長などは、さぞかし知能が高いのだろうと思うが、必ずしもそうだとは言えない。</p>\n\t\t\t\t\t\t<p class=\"bg-cauvn\">　　Nhiều người nghĩ rằng những nhân vật nổi tiếng hoặc giám đốc của các tập đoàn lớn trên thế giới hẳn phải có trí thông minh cao, nhưng không phải lúc nào cũng vậy.</p>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"jlpt-lesson-tuvung\">\n\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"accordion accordion-wrapper\" id=\"accordion_13733798_1\">"}]},{"title":"Bài 7","dethiCode":"iGSSxb_HvM2ZpZzNub200KCelMqswoHAZWo-","totalQuestions":1,"questions":[{"cau":"1","question":"","passage":null,"audio":null,"image":null,"choices":[],"correctAnswer":"","explanationText":"Về việc sử dụng tài liệu nghe nhìn (băng video, CD, DVD)\n\nTóm tắt Dịch Hint Memo Từ vựng tổng --> ► 視聴覚資料（ビデオテープ・CD・DVD ）をご利用いただくにあたって Về việc sử dụng tài liệu nghe nhìn (băng video, CD, DVD)","explanationHtml":"<div class=\"jlpt-lesson col-md-8 mx-auto\">\n\t<div class=\"row\">\n\t\t\t\t\t<div class=\"jlpt-lesson-btn-group mb-6\">\n\t\t\t\t<button class=\"btn btn-primary btn-sm rounded-pill btn_tomtat\"><i class=\"uil uil-book-open\"></i> Tóm tắt</button>\n\t\t\t\t<button class=\"btn btn-primary btn-sm rounded-pill btn_dichtong\"><i class=\"uil uil-graduation-cap\"></i> Dịch</button>\n\t\t\t\t<button class=\"btn btn-primary btn-sm rounded-pill btn_hint\"><i class=\"uil uil-lightbulb-alt\"></i> Hint</button>\n\t\t\t\t<button class=\"btn btn-primary btn-sm rounded-pill btn_memo\"><i class=\"uil uil-notes\"></i> Memo</button>\n\t\t\t\t<!-- <button class=\"btn btn-primary btn-sm rounded-pill btn_tuvungtong\"><i class=\"uil uil-notes\"></i> Từ vựng tổng</button> -->\n\t\t\t</div>